# ============================================================
# Pelada App v2 — Variáveis de Produção (VPS / Hostinger)
# Copie este arquivo para .env.production e defina senhas fortes:
# cp .env.production.example .env.production
# ============================================================

# Porta externa exposta pelo Nginx na VPS (coexistência com outros projetos)
# 8080: garden/steelers | 8081: sales-system/portfolio | 8082: blood-match | 8083: gps-tracking
PORT=8084

# Banco de Dados PostgreSQL (Interno na rede Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_muito_forte_aqui
POSTGRES_DB=pelada_app

# URLs de Acesso
# Vazio no browser para usar caminhos relativos (/api) roteados pelo Nginx
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:3001
CORS_ORIGIN=*
